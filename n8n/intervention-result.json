      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ recorded: true, result: $json.body }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "1618d2dc-6c9f-5db2-9d68-6022292a67b0",
      "name": "Done",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
