{
  "name": "AquaPulse 2 - Critical alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aquapulse/incident-critical",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "fd2726b5-eab6-5eaa-ade1-19dba5f3c4c2",
      "name": "Incident update",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "ae0ca80d-f2f0-5ffd-a50e-daf680092b74"
    },
    {
      "parameters": {
        "jsCode": "// Alert only when the incident is CRITICAL (risk >= 80) and its Evidence Score has escalated (>= 70).\n// Thresholds mirror the AquaPulse engine config; the engine remains the authority on both numbers.\nconst b = $input.first().json.body ?? {};\nconst send = Number(b.risk) >= 80 && Number(b.evidenceScore) >= 70 && !!b.incidentId;\nconst to = [...new Set((b.recipients ?? []).map(String))];   // de-duplicate recipients\nreturn [{ json: { send, alert: {\n  incidentId: b.incidentId,\n  audience: b.audience ?? 'Residents near the incident',\n  body: b.message ?? `AquaPulse alert ${b.incidentId}: flooding risk is critical near ${b.area ?? 'your area'}. Avoid low-lying roads.`,\n  to,\n  idempotencyKey: `alert:${b.incidentId}:critical`,          // one critical alert per incident, however often this fires\n} } }];"
      },
      "id": "28c15128-4e70-5ff1-859e-04b667c4a910",
      "name": "Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "471a99c1-cb14-54f5-ae94-dda6ea9cf8e9",
              "leftValue": "={{ $json.send }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "bb30d5da-b298-5a3a-ab8a-4835e8d1bb59",
      "name": "Send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AQUAPULSE_URL }}/api/webhooks/alert",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-aquapulse-secret",
              "value": "={{ $env.AQUAPULSE_WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.alert) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "3ffbd170-70fb-5e25-9533-6d6de11ae719",
      "name": "AquaPulse alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: $json.statusCode, result: $json.body }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "98463761-22ca-5c47-b7ed-cd934607fb6b",
      "name": "Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        -100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ sent: false, reason: \"below critical risk or evidence threshold\" }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "14744409-376e-5ea1-8628-71d6731f7ada",
      "name": "Not sent",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        120
      ]
    }
  ],
  "connections": {
    "Incident update": {
      "main": [
        [
          {
            "node": "Gate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gate": {
      "main": [
        [
          {
            "node": "Send?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send?": {
      "main": [
        [
          {
            "node": "AquaPulse alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Not sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AquaPulse alert": {
      "main": [
        [
          {
            "node": "Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 120
  },
  "active": false
}