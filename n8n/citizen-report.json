    {
      "parameters": {
        "jsCode": "// Orchestration only. No scoring, no fusion and no signature maths here: AquaPulse verifies Twilio's signature itself.\n// This node just prepares the forward: the original form fields, the signature header, and the URL Twilio signed.\nconst item = $input.first().json;\nconst fields = item.body ?? {};\nconst headers = item.headers ?? {};\nif (!fields.MessageSid || !fields.From) return [{ json: { valid: false, reason: 'MessageSid and From are required' } }];\nreturn [{ json: {\n  valid: true,\n  form: new URLSearchParams(Object.entries(fields).map(([k, v]) => [k, String(v)])).toString(),\n  signature: headers['x-twilio-signature'] ?? '',\n  signedUrl: item.webhookUrl,   // the public URL of this webhook: what Twilio signed\n} }];"
      },
      "id": "c8b40956-89b6-5ffa-a8ec-d8464f5da8d5",
      "name": "Prepare forward",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
