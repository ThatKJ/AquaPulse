{
  "name": "AquaPulse — Citizen Report Ingestion",
  "nodes": [
    {
      "id": "102ca6f5-06e3-452a-b43a-fd282a4f0f19",
      "name": "Twilio inbound",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        96
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "aquapulse/citizen-report",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "b8daa760-a3b7-449a-b8d4-bbf1c47dbb0c"
    },
    {
      "id": "08ac35c0-31e9-451b-bfe7-e0a193f3c8c0",
      "name": "AquaPulse: verify, analyse, store",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        96
      ],
      "parameters": {
        "method": "POST",
        "url": "https://aquapulse-liard.vercel.app/api/webhooks/twilio",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-twilio-signature",
              "value": "={{ $json.headers[\"x-twilio-signature\"] ?? \"\" }}"
            },
            {
              "name": "x-twilio-original-url",
              "value": "={{ $json.webhookUrl }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/x-www-form-urlencoded",
        "body": "={{ Object.entries($json.body ?? {}).map(([k, v]) => encodeURIComponent(k) + \"=\" + encodeURIComponent(String(v))).join(\"&\") }}",
        "options": {
          "timeout": 45000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "b5bfceb8-6605-4163-bac4-721338035220",
      "name": "Return AquaPulse response to Twilio",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        448,
        0
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ typeof $json.body === 'string' ? $json.body : ($json.data ?? JSON.stringify($json.body ?? '')) }}",
        "options": {
          "responseCode": "={{ $json.statusCode ?? 200 }}",
          "responseHeaders": {
            "entries": [
              {
                "name": "content-type",
                "value": "={{ $json.headers?.[\"content-type\"] ?? \"text/xml; charset=utf-8\" }}"
              }
            ]
          }
        }
      }
    },
    {
      "id": "37afaee2-ce4a-426a-a6dc-760aa10ed1b8",
      "name": "AquaPulse unreachable: 502",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        448,
        192
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "AquaPulse could not be reached.",
        "options": {
          "responseCode": 502,
          "responseHeaders": {
            "entries": [
              {
                "name": "content-type",
                "value": "text/plain; charset=utf-8"
              }
            ]
          }
        }
      }
    }
  ],
  "connections": {
    "Twilio inbound": {
      "main": [
        [
          {
            "node": "AquaPulse: verify, analyse, store",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AquaPulse: verify, analyse, store": {
      "main": [
        [
          {
            "node": "Return AquaPulse response to Twilio",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "AquaPulse unreachable: 502",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": true
}
