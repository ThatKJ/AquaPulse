            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cc0967cb-c9b2-547e-930a-e231ac534f6b",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "a3fd8701-d485-5570-819b-25c1ee37cf17",
