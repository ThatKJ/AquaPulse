# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: only the example, which holds names and no values, is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling
!.env.example
.playwright-mcp/
.impeccable/
infra/ai-lambda/dist/

# Demo film: raw footage, the edit project and its renders stay local.
# The edit project has its own dependencies and would break the site build if committed here.
docs/demo-recording/
video/
video-design/
