# Copy to .env.local. Nothing here is required to run the deterministic demo.

# --- AWS (server only) ---
# Local dev uses your AWS CLI session (`aws login`); no keys go in this file.
AWS_REGION=ap-south-1
# Set from the output of `npm run verify:bedrock`. Leave blank to use Rekognition.
BEDROCK_MODEL_ID=
# Set on the public host so AI calls go through the deployed Lambda.
AI_ENDPOINT_URL=
AI_ENDPOINT_SECRET=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Twilio (optional; demo transport is used when blank) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# demo (default) records alerts only. live sends, and only to the allowlisted numbers.
TWILIO_MODE=demo
TWILIO_ALLOWED_TO=

# --- n8n / webhooks ---
WEBHOOK_SECRET=
