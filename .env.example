# Copy to .env.local. Nothing here is required to run the deterministic demo.

# --- AWS (server only) ---
# Local dev uses your AWS CLI session (`aws login`); no keys go in this file.
AWS_REGION=ap-south-1
# Set from the output of `npm run verify:bedrock`. Leave blank to use Rekognition.
BEDROCK_MODEL_ID=
# Set on the public host so AI calls go through the deployed Lambda.
AI_ENDPOINT_URL=
AI_ENDPOINT_SECRET=
# Amazon SNS topic ARN for emergency municipal responder broadcasts (e.g., arn:aws:sns:ap-south-1:123456789012:aquapulse-emergency-broadcast)
AWS_SNS_TOPIC_ARN=
# Amazon S3 bucket for durable evidence storage (e.g., aquapulse-evidence-prod)
AWS_S3_EVIDENCE_BUCKET=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Twilio (optional; demo transport is used when blank) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# demo (default) records alerts only. live sends, and only to the allowlisted numbers.
TWILIO_MODE=demo
TWILIO_ALLOWED_TO=
# Trial WhatsApp only: a Twilio-provided template SID (HX...) used for acknowledgements instead of free text
TWILIO_ACK_CONTENT_SID=
# Exact URL of the n8n webhook Twilio calls when n8n sits in front (signatures for it are accepted too)
TWILIO_FORWARDER_URL=

# --- n8n / webhooks ---
WEBHOOK_SECRET=

# --- doctor only ---
# Deployed site to check with `npm run doctor`.
AQUAPULSE_PUBLIC_URL=
# Set when an n8n instance exists.
N8N_BASE_URL=
